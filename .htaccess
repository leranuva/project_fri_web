<IfModule mod_rewrite.c>
    RewriteEngine On
    # Deny hidden files (apart from domain validation) and private project paths.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    RewriteRule ^(?:app|bootstrap|config|database|docs|node_modules|resources|routes|scripts|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js)$ - [F,L,NC]

    RewriteRule ^(?:htacces|htaccess|import_logos\.php|README\.md|(?:postcss|tailwind)\.config\.js)$ - [F,L,NC]
    RewriteRule \.(?:sql(?:\.gz)?|log|bak|zip|tar(?:\.gz)?)$ - [F,L,NC]

    RewriteRule ^(?!public(?:/|$))(.*)$ public/$1 [L]
</IfModule>
